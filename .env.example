# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public storage bucket created by supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_BUCKET=media

# Object path of the default avatar inside that bucket.
# Must match the object name exactly, including its file extension.
NEXT_PUBLIC_PLACEHOLDER_DEAFULT_IMAGE_ID=placeholder-avatar.png
