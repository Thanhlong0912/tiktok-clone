# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase S3 uploads sign with the *legacy* anon key (a JWT starting
# "eyJ"), from Project settings -> API -> Legacy API keys. The newer
# sb_publishable_ format is not accepted for S3 session-token auth yet
# (supabase/storage#750). This is separate from NEXT_PUBLIC_SUPABASE_ANON_KEY
# above, which the supabase-js client keeps using.
NEXT_PUBLIC_SUPABASE_LEGACY_ANON_KEY=

# Public storage bucket created by supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_BUCKET=media

# Object path of the default avatar inside that bucket.
# Must match the object name exactly, including its file extension.
NEXT_PUBLIC_PLACEHOLDER_DEAFULT_IMAGE_ID=placeholder-avatar.png

# Supabase → Project settings → Storage → S3 connection.
# The "S3 connection" toggle on that page must be enabled.
NEXT_PUBLIC_SUPABASE_REGION=us-east-1

# Optional. Overrides where public media urls are read from (e.g. a CDN).
# Defaults to <NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/<bucket>.
# NEXT_PUBLIC_MEDIA_BASE_URL=

# Server-only. Used by scripts/media/*, never by the app.
# These bypass Row Level Security -- do not prefix them with NEXT_PUBLIC_.
# Generate the S3 pair at Supabase → Project settings → Storage → S3 connection.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_SERVICE_ROLE_KEY=
